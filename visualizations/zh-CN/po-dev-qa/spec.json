  "cards": [
    {
      "dot": "cyan",
      "title": "共享 Test Case · Jira",
      "items": [
        "Story / AC → 一个 Test Design Task：Case ID、数据、步骤、预期、清理。",
        "QA 批准；DEV 维护关联脚本。变更先评估、按影响重批与复验。"
      ]
    },
    {
      "dot": "emerald",
      "title": "实现与测试证据 · GitLab",
      "items": [
        "技术 Spec / 脚本 / 完整报告留在代码库；TDD 仅 Implement。",
        "QA 记录用例、候选、环境、数据版本；人工项需真实观察。"
      ]
    },
    {
      "dot": "rose",
      "title": "正式 Verify · QA 证据齐备之后",
      "items": [
        "父协调器派发独立双 Reviewer，再派独立 Collector；资源隔离才可并行。",
        "FAIL / NOT_RUN / 漂移阻止通过。批准绑定身份与版本；不自动 Done / 发布。"
      ]
    }
