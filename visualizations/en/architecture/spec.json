  "cards": [
    {
      "dot": "cyan",
      "title": "Instruction architecture",
      "items": [
        "Skills + host tools; no new runtime, service, database, or per-event agent.",
        "The parent controls the frozen plan and appends source-backed lifecycle events."
      ]
    },
    {
      "dot": "emerald",
      "title": "Evidence authority",
      "items": [
        "Git, Jira, CI/CD and host receipts supply evidence; model-written logs are claims.",
        "Helpers validate bindings and structure; they do not grant PASS or approval."
      ]
    },
    {
      "dot": "amber",
      "title": "Measurement boundary",
      "items": [
        "Compare all-role human effort and comparable baselines; retain native usage separately.",
        "Unknowns remain unknown. Verified handoff does not prove business benefit or AI causality."
      ]
    }
  ]
