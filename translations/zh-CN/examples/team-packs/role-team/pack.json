      "outputs": [{"name": "test-design.json", "contract": "quality", "template": "core:templates/collaboration/test-design.json"}],
      "capabilities": ["evidence.read"], "tool_binding_ids": [], "auto_eligible": false, "routing_facts": {}
    },
    {
      "id": "team.role-intake", "kind": "analysis", "role": "core:agents/po.md",
      "prompt": "team:prompts/intake.md", "instructions": ["core:workflow/role-worker.md"],
      "inputs": ["request", "project"], "optional_inputs": [],
      "outputs": [
        {"name": "source-spec.md", "contract": "spec", "template": "core:templates/spec/spec.md"},
        {"name": "acceptance.json", "contract": "spec", "template": "core:templates/spec/acceptance.json"},
        {"name": "test-design.json", "contract": "analysis", "template": "core:templates/collaboration/test-design.json"}
