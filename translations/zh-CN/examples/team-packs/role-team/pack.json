      "id": "team.role-design", "kind": "design", "role": "core:agents/architect.md",
      "prompt": "team:prompts/design.md", "instructions": ["core:workflow/role-worker.md"],
      "inputs": ["spec", "analysis", "project"], "optional_inputs": [],
      "outputs": [
        {"name": "technical-spec.md", "contract": "architecture", "template": "team:templates/technical-spec.md"},
        {"name": "architecture-fitness.json", "contract": "architecture", "template": "core:templates/architecture/architecture-fitness.json"},
        {"name": "quality-design.json", "contract": "quality", "template": "team:templates/quality-design.json"},
        {"name": "quality-fitness.json", "contract": "quality", "template": "core:templates/quality/quality-fitness.json"},
        {"name": "coverage.json", "contract": "quality", "template": "core:templates/quality/coverage.json"},
        {"name": "implementation-plan.json", "contract": "plan", "template": "team:templates/implementation-plan.json"}
