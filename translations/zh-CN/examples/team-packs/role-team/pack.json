    {
      "id": "team.story", "kind": "specification", "role": "core:agents/po.md",
      "prompt": "team:prompts/story.md", "instructions": ["core:workflow/role-worker.md"],
      "inputs": ["request"], "optional_inputs": ["project"],
      "outputs": [
        {"name": "story.md", "contract": "spec", "template": "core:templates/collaboration/story.md"},
        {"name": "acceptance.json", "contract": "spec", "template": "core:templates/spec/acceptance.json"}
      ],
      "capabilities": ["evidence.read"], "tool_binding_ids": [], "auto_eligible": false, "routing_facts": {}
    },
    {
      "id": "team.test-design", "kind": "analysis", "role": "core:agents/qe.md",
      "prompt": "team:prompts/test-design.md",
