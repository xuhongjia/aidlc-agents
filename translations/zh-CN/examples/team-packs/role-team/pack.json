      "prompt": "core:prompts/verify.md",
      "instructions": ["core:workflow/role-worker.md", "team:prompts/verify-handoff.md"],
      "inputs": ["spec", "architecture", "quality", "implementation", "analysis"], "optional_inputs": [],
      "outputs": [
        {"name": "verification.md", "contract": "verification", "template": "core:templates/verify/verification.md"},
