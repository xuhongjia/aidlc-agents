  "workflows": [
    {
      "id": "team.prd", "intent": "analysis", "risk_ceiling": "any", "entry": "prd",
      "nodes": [{"step_id": "prd", "stage_id": "team.prd", "bindings": {"request": ["$request"], "project": ["$project"]}}],
      "edges": [], "switches": [], "terminals": [{"step_id": "prd", "outcome": "analysis_complete"}]
    },
    {
      "id": "team.story", "intent": "analysis", "risk_ceiling": "any", "entry": "story",
      "nodes": [{"step_id": "story", "stage_id": "team.story", "bindings": {"request": ["$request"], "project": ["$project"]}}],
      "edges": [], "switches": [], "terminals": [{"step_id": "story", "outcome": "analysis_complete"}]
    },
    {
      "id": "team.test-design", "intent": "analysis", "risk_ceiling": "any", "entry": "test-design",
      "nodes": [{"step_id": "test-design", "stage_id": "team.test-design", "bindings": {"request": ["$request"], "project": ["$project"]}}],
      "edges": [], "switches": [], "terminals": [{"step_id": "test-design", "outcome": "analysis_complete"}]
    },
    {
      "id": "team.role-delivery", "intent": "delivery", "risk_ceiling": "any", "entry": "intake",
      "nodes": [
        {"step_id": "intake", "stage_id": "team.role-intake", "bindings": {"request": ["$request"], "project": ["$project"]}},
        {"step_id": "design", "stage_id": "team.role-design", "bindings": {"spec": ["intake"], "analysis": ["intake"], "project": ["$project"]}},
        {"step_id": "implement", "stage_id": "team.role-implement", "authority": "design", "bindings": {"spec": ["intake"], "architecture": ["design"], "quality": ["design"], "plan": ["design"], "analysis": ["intake"]}},
        {"step_id": "qa", "stage_id": "team.role-qa", "bindings": {"spec": ["intake"], "quality": ["design"], "implementation": ["implement"], "analysis": ["intake"]}},
        {"step_id": "verify", "stage_id": "team.role-verify", "bindings": {"spec": ["intake"], "architecture": ["design"], "quality": ["design"], "implementation": ["implement"], "analysis": ["qa"]}}
      ],
      "edges": [
        {"from": "intake", "to": "design"}, {"from": "design", "to": "implement"},
        {"from": "implement", "to": "qa"}, {"from": "qa", "to": "verify"}
      ],
      "switches": [], "terminals": [{"step_id": "verify", "outcome": "verified"}]
    }
  ],
  "overrides": [],
  "tool_bindings": []
}
