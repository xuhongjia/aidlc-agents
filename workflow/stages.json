{
  "schema_version": 3,
  "default_profile": "auto",
  "composition": {
    "contract_version": 1,
    "protocol": "workflow/extensions.md",
    "scheduler": "workflow/dag.md",
    "stage_contracts": "workflow/stage-contracts.json",
    "skill": "skills/aidlc-workflow/SKILL.md",
    "dispatch_prompt": "prompts/composed-stage.md",
    "lock_template": "templates/work/workflow-lock.json"
  },
  "knowledge": {
    "contract_version": 1,
    "protocol": "workflow/knowledge.md",
    "read_stages": ["intake", "scope", "diagnose"],
    "prepare_stages": ["verify", "learn"],
    "hook_skill": "skills/aidlc-knowledge-sync/SKILL.md",
    "dispatch_template": "templates/knowledge/dispatch.json",
    "types": ["architecture", "quality", "anti_pattern", "lesson"],
    "providers": ["confluence_cloud"],
    "default_publish_authorization": null
  },
  "closure": {
    "protocol": "workflow/closure.md",
    "template": "templates/work/closure.json",
    "confirmation": "explicit-approver",
    "pending_status": "closing",
    "terminal_status": "closed",
    "requires_remaining_stage_approval": false,
    "requires_stopped_workers": true
  },
  "external_evidence": {
    "stages": ["release", "learn"],
    "access": "read-only",
    "protocol": "workflow/external-evidence.md",
    "required_evidence": [
      {"name": "source-index.json", "template": "templates/work/source-index.json"}
    ]
  },
  "approver_resolution": {
    "precedence": ["jira_assignee", "git_config", "system_login"],
    "template": "templates/work/approver.json",
    "missing_email": null,
    "refresh_before_approval": true
  },
  "gates": {
    "required_profiles": ["standard", "enhance", "fix"],
    "required_stage": "verify",
    "minimum_blocking_checks_per_kind": 1,
    "on_missing": "define_then_implement",
    "allow_manual_substitute": false,
    "design_prompt": "prompts/gate-design.md",
    "required_evidence": [
      {"kind": "architecture", "name": "architecture-gate.json", "template": "templates/work/gate-result.json"},
      {"kind": "quality", "name": "quality-gate.json", "template": "templates/work/gate-result.json"}
    ]
  },
  "approval": {
    "default_mode": "manual",
    "auto_low_risk": {
      "profiles": ["enhance", "fix"],
      "stages": ["scope", "diagnose", "implement", "verify"],
      "policy_template": "templates/work/approval-policy.json"
    }
  },
  "profiles": {
    "standard": {
      "stages": ["intake", "spec", "architecture", "quality", "plan", "implement", "verify", "release", "learn"],
      "implementation_authority": "plan",
      "terminal_stage": "learn",
      "artifact_mode": "standard",
      "output_overrides": {}
    },
    "enhance": {
      "stages": ["scope", "implement", "verify"],
      "implementation_authority": "scope",
      "terminal_stage": "verify",
      "artifact_mode": "compact",
      "output_overrides": {
        "implement": [{"name":"verification.md","template":"templates/compact/verification.md"}],
        "verify": [{"name":"verification.md","template":"templates/compact/verification.md"}]
      }
    },
    "fix": {
      "stages": ["diagnose", "implement", "verify"],
      "implementation_authority": "diagnose",
      "terminal_stage": "verify",
      "artifact_mode": "compact",
      "output_overrides": {
        "implement": [{"name":"verification.md","template":"templates/compact/verification.md"}],
        "verify": [{"name":"verification.md","template":"templates/compact/verification.md"}]
      }
    }
  },
  "execution": {
    "mode": "isolated-subagents",
    "context_policy": "fresh-minimal",
    "coordinator": "parent",
    "inline_fallback": false,
    "new_agent_per_stage": true,
    "max_parallel_workers": 2,
    "dispatch_template": "templates/work/dispatch.json",
    "result_template": "templates/work/stage-result.json"
  },
  "stages": [
    {"id":"intake","role":"BA / PO","agent":"ba","prompt":"prompts/intake.md","outputs":["intake.md","project-context.md"],"approval":"需求人 / PO","product_write":false,"parallel_lanes":["business-context","repository-context"]},
    {"id":"spec","role":"BA / PO","agent":"po","prompt":"prompts/spec.md","outputs":["spec.md","acceptance.json"],"approval":"PO","product_write":false,"parallel_lanes":["ac-review","nfr-review"]},
    {"id":"architecture","role":"Architect","agent":"architect","prompt":"prompts/architecture.md","outputs":["architecture.md","architecture-fitness.json"],"approval":"架构责任人","product_write":false,"parallel_lanes":["dependency-review","security-performance-review"]},
    {"id":"quality","role":"QE","agent":"qe","prompt":"prompts/quality.md","outputs":["quality-design.md","quality-fitness.json","coverage.json"],"approval":"质量责任人","product_write":false,"parallel_lanes":["functional-design","nonfunctional-design"]},
    {"id":"plan","role":"PM / DEV / QE","agent":"pm","prompt":"prompts/plan.md","outputs":["plan.md"],"approval":"交付责任人","product_write":false,"parallel_lanes":["implementation-estimate","verification-estimate"]},
    {"id":"implement","role":"DEV","agent":"engineer","prompt":"prompts/implement.md","outputs":["implementation.md"],"approval":"代码审查人","product_write":true,"parallel_lanes":["approved-independent-tasks"]},
    {"id":"verify","role":"QE / Architect","agent":"qe","prompt":"prompts/verify.md","outputs":["verification.md","acceptance-results.json"],"approval":"质量 / 架构责任人","product_write":false,"parallel_lanes":["architecture-gate","quality-gate"]},
    {"id":"release","role":"Service Owner / DEV / QE","agent":"engineer","prompt":"prompts/release.md","outputs":["release-readiness.md"],"approval":"服务责任人","product_write":false,"parallel_lanes":["rollback-review","observability-review"]},
    {"id":"learn","role":"PO / PM / Service Owner","agent":"po","prompt":"prompts/learn.md","outputs":["outcome.md","outcome.json"],"approval":"PO / 服务责任人","product_write":false,"parallel_lanes":["business-observation","delivery-retrospective"]},
    {"id":"scope","role":"BA / DEV","agent":"engineer","skill":"skills/aidlc-enhance/SKILL.md","prompt":"prompts/scope.md","outputs":["change.md"],"template_directory":"templates/compact","approval":"需求人 / 技术责任人","product_write":false,"parallel_lanes":["impact-review","acceptance-review"]},
    {"id":"diagnose","role":"DEV / QE","agent":"engineer","skill":"skills/aidlc-fix/SKILL.md","prompt":"prompts/diagnose.md","outputs":["change.md"],"template_directory":"templates/compact","approval":"缺陷责任人 / 技术责任人","product_write":false,"parallel_lanes":["reproduction","cause-analysis"]}
  ]
}
